{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "nord",
    "mode": "dark"
  },
  "keybinds": {
    "app.exit": "<leader>q",
    "theme.switch_mode": "<leader>d"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
